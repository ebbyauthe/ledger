PORT=3000

# Password for your existing (first/default) business profile at /admin.
# Required in production.
ADMIN_PASSWORD=changeme

# Shared invite code required to create a new business profile from the /admin
# login screen ("Create a profile"). Keep this private -- anyone with it can
# spin up a new profile on your database. Required in production.
SIGNUP_CODE=changeme

# Leave both blank for local dev -- the app will use a local SQLite file at
# data/local.db instead. Fill these in with your Turso database's values
# when deploying (see README.md).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
